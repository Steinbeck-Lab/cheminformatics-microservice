ARG PYTHON_IMAGE=python:3.11-slim-bookworm
FROM ${PYTHON_IMAGE} AS cheminf-python-ms

ENV INCLUDE_OCSR=false \
    JAVA_HOME=/opt/java \
    # Add default number of workers
    WORKERS=1 \
    # Add other Python configurations
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install runtime dependencies
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        default-jre-headless \
        curl \
        build-essential \
        git \
        libgl1 \
        libglib2.0-0 \
        libxrender1 \
        wget && \
    ln -s "$(dirname "$(dirname "$(readlink -f /usr/bin/java)")")" "${JAVA_HOME}" && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    wget -O /usr/bin/surge "https://github.com/StructureGenerator/surge/releases/download/v1.0/surge-linux-v1.0" && \
    chmod +x /usr/bin/surge

# Cache the Java dependencies used by cdk_wrapper so startup needs no JAR downloads.
RUN mkdir -p /root/.data/JAVA-DEPENDENCIES && \
    wget -O /root/.data/JAVA-DEPENDENCIES/cdk-2.10.jar \
    https://github.com/cdk/cdk/releases/download/cdk-2.10/cdk-2.10.jar && \
    wget -O /root/.data/JAVA-DEPENDENCIES/SugarRemovalUtility-jar-with-dependencies.jar \
    https://github.com/JonasSchaub/SugarRemoval/releases/download/v1.3.2/SugarRemovalUtility-jar-with-dependencies.jar && \
    wget -O /root/.data/JAVA-DEPENDENCIES/centres.jar \
    https://github.com/SiMolecule/centres/releases/download/1.0/centres.jar && \
    wget -O /root/.data/JAVA-DEPENDENCIES/opsin-cli-2.8.0-jar-with-dependencies.jar \
    https://github.com/dan2097/opsin/releases/download/2.8.0/opsin-cli-2.8.0-jar-with-dependencies.jar

WORKDIR /code
COPY requirements_lite.txt .
RUN python -m pip install --no-cache-dir -U pip setuptools && \
    python -m pip install --no-cache-dir -r requirements_lite.txt && \
    python -m pip check

RUN mkdir -p /root/.data/NP_model && \
    python -c "import shutil; from rdkit import RDConfig; shutil.copyfile(RDConfig.RDContribDir + '/NP_Score/publicnp.model.gz', '/root/.data/NP_model/publicnp.model.gz')" && \
    chmod 644 /root/.data/JAVA-DEPENDENCIES/opsin-cli-2.8.0-jar-with-dependencies.jar

COPY ./app /code/app

CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port 80 --workers ${WORKERS}"]
